# App-owned key only (not configurable in the UI).
# Get one at https://openrouter.ai/keys then restart Expo.
# Local: copy to .env — Metro + app.config.js pick this up for Expo Router.
# EAS Build / Hosting / Update: set the same var on the Expo project environment.
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional model override:
# EXPO_PUBLIC_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct
