{
  "expo": {
    "name": "Financial Copilot",
    "slug": "financial-copilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financialcopilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F7F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.financialcopilot.app",
      "infoPlist": {
        "NSDocumentsFolderUsageDescription": "Financial Copilot needs document access to import PDF bank statements.",
        "NSPhotoLibraryUsageDescription": "Financial Copilot may access photos if you pick a statement image.",
        "NSFaceIDUsageDescription": "Financial Copilot uses Face ID to unlock your ledger and reveal a hidden balance.",
        "NSUserNotificationsUsageDescription": "Financial Copilot sends ledger digests, goal milestones, and streak reminders."
      }
    },
    "android": {
      "package": "com.financialcopilot.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7F4"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Financial Copilot to use Face ID to unlock your ledger."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1B4332",
          "defaultChannel": "ledger",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
